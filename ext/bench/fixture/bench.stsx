import { error, service } from "./service.sts" for syntax;
import { effect, handle } from "./effect.sts" for syntax;
import { query } from "./query.sts" for syntax;
import { each, when } from "./jsx.sts" for syntax;
import { Context, Data, Effect, Layer } from "effect";
import { and, asc, desc, eq, gt, gte, lt, lte, ne, or } from "drizzle-orm";
import type { NodePgDatabase } from "drizzle-orm/node-postgres";
import { boolean, integer, pgTable, serial, text } from "drizzle-orm/pg-core";
import { Fragment, h } from "./jsx-runtime.js";

void h;
void Fragment;

error DbError { sql: string }
error NotFound { id: string }

service Database {
  query(sql: string): Effect<readonly string[], DbError>;
  lookup(id: string): Effect<string, NotFound>;
}

export const users = pgTable("users", {
  id: serial().primaryKey(),
  name: text().notNull(),
  age: integer().notNull(),
});

export const posts = pgTable("posts", {
  id: serial().primaryKey(),
  authorId: integer().notNull(),
  title: text().notNull(),
  published: boolean().notNull(),
});


effect report_0(id: string) {
  user <- lookup(id);
  rows <- lookup(id);
  const count = rows.length + rows.length;
  return `${user}: ${count}`;
}

export const safe_0 = (id: string) => handle report_0(id) {
  NotFound(error) => Effect.succeed(`no such user ${error.id}`),
  DbError(error) => Effect.succeed(`query failed: ${error.sql}`)
};

export const feed_0 = (db: NodePgDatabase, minAge: number) =>
query(db) {
  select { author: users.name, title: posts.title }
  from users
  join posts on posts.authorId == users.id
  where users.age >= minAge and posts.published == true
  order by users.name, posts.id desc
  limit 20
};

export const panel_0 = (items: readonly string[], loading: boolean) => (
  <section>
    {when (loading)}
      <p>loading 0</p>
    {else}
      <p>ready 0</p>
    {end}
    {each (items as item, index)}
      <span key={index}>{item}</span>
    {end}
  </section>
);


