{
  "name": "ts-rust-examples",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ts-rust-examples",
      "devDependencies": {
        "ext-syntax": "file:../crates/ts_ext_syntax",
        "typescript": "file:../npm/typescript"
      }
    },
    "../crates/ts_ext_syntax": {
      "name": "ext-syntax",
      "version": "0.0.0",
      "dev": true,
      "bin": {
        "ext-syntax": "bin/ext-syntax"
      },
      "devDependencies": {
        "@napi-rs/cli": "3.7.1"
      }
    },
    "../npm/typescript": {
      "version": "0.0.0",
      "dev": true,
      "bin": {
        "tsc": "bin/tsc"
      }
    },
    "node_modules/ext-syntax": {
      "resolved": "../crates/ts_ext_syntax",
      "link": true
    },
    "node_modules/typescript": {
      "resolved": "../npm/typescript",
      "link": true
    }
  }
}
