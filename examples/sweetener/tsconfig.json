{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true
  },
  "files": ["src/main.ts", "src/logic.sts"],
  "contentMappers": [
    { "package": "ext-syntax", "extensions": [".sts", ".stsx"] }
  ]
}
