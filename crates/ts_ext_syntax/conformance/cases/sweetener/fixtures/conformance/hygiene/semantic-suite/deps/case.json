{
  "$schema": "../../../../schemas/case.schema.json",
  "id": "hygiene/semantic-suite",
  "languageVersion": "0.1",
  "typescriptVersion": "6.0.2",
  "compilerOptions": {
    "strict": true
  },
  "capabilities": [
    "HYGIENE-BINDING-CONTRACTS",
    "HYGIENE-BINDING-RESOLUTION",
    "HYGIENE-NAME-ASSIGNMENT",
    "TEMPLATE-DECLARATIVE-OPERATIONS",
    "TEMPLATE-INSTANTIATION"
  ],
  "entry": "input.sts",
  "expect": {
    "expansion": true,
    "bindings": true,
    "trace": true,
    "types": true,
    "runtime": true
  },
  "limits": {}
}
