export syntax class ConstructorField {
  fields {
    name: binding;
    valueType: type;
  }

  rule { $name:binding: $valueType:type }
  expect "field type after colon";
}

export syntax class ConstructorDeclaration {
  fields {
    name: ident;
    fields: ConstructorField*;
  }

  rule {
    $name:ident($($fields:ConstructorField),*)
  }
  expect "field type after colon";
}

export syntax data:item {
  rule {
    data $name:binding<$typeParameter:binding> =
      $($constructor:ConstructorDeclaration)|+;
  }
  bind $name in following as recursive type;
  bind $constructor.name in following as recursive value;
  bind $typeParameter in $constructor.fields.valueType as lexical type;
  bind $constructor.fields.name in $constructor.fields.name as lexical value;
  expect "field type after colon";
  => {
    #core(type $name<$typeParameter> =
      $({
        readonly tag: #text($constructor.name);
        $($constructor.fields.name: $constructor.fields.valueType;)*
      })|+;)

    $(#core(const $constructor.name = <$typeParameter>(
      $($constructor.fields.name: $constructor.fields.valueType),*
    ): $name<$typeParameter> => ({
      tag: #text($constructor.name)
      #if(present $constructor.fields) {
        , $($constructor.fields.name),*
      }
    });))*
  }
}

export syntax class ConstructorPattern {
  fields {
    name: ident;
    binders: binding*;
  }

  rule { $name:ident($($binders:binding),*) }
  refine $binders spelling starts-with-lowercase
}

export syntax match:expr {
  rule {
    match ($value:expr) {
      $($arm:ConstructorPattern => $result:expr;)+
    }
  }
  bind $arm.binders in $result as lexical value;
  expect "constructor match arm";
  => {
    ({
      value: $value,
      run() {
        $(if (this.value.tag === #text($arm.name)) {
          #if(present $arm.binders) {
            const { $($arm.binders),* } = this.value;
          }
          return $result;
        })*
        const unmatched: never = this.value;
        throw new globalThis.Error(
          "No match for " + globalThis.JSON.stringify(unmatched),
        );
      },
    }).run()
  }
}
