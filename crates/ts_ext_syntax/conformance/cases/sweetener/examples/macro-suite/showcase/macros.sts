export syntax twice:expr {
  rule { twice($value:expr) } => { [$value, $value] }
}

export syntax surround:expr {
  rule { surround($value:expr, $left:expr, $right:expr) }
  => { `${$left}${$value}${$right}` }
}

export syntax dramatic:expr {
  rule { dramatic($value:expr) } => { `${$value}!!!` }
}

export syntax emergencyConfetti:expr {
  rule { emergencyConfetti($value:expr) }
  => { `🎉 ${$value} 🎉` }
}

export syntax orElse:expr {
  rule { orElse($value:expr, $backup:expr) }
  => { $value ?? $backup }
}

export syntax collect:expr {
  rule { collect($($value:expr),+) } => { [$($value),*] }
}

export syntax unless:stmt {
  rule { unless($condition:expr) $body:stmt }
  => { if (!($condition)) $body }
}

export syntax repeat:stmt {
  rule { repeat($count:expr) $body:stmt }
  => { for (let index = 0; index < $count; index += 1) $body }
}

export syntax maybe:type {
  rule { maybe<$value:type> } => { $value | undefined }
}

export syntax readonlyList:type {
  rule { readonlyList<$value:type> } => { ReadonlyArray<$value> }
}

export syntax summon:item {
  rule { summon $name:binding }
  bind $name in following as lexical value;
  => { const $name = 42; }
}

export operator (|>):expr {
  fixity infix;
  associativity left;
  precedence 40;
  rule { $value:expr |> $callee:ident } => { $callee($value) }
}
