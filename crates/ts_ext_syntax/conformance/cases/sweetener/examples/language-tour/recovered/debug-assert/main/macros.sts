// `#text($value)` yields the source text of a capture, as a string. That is
// what makes a macro able to report the expression you actually wrote.
export syntax dbg:expr {
  rule { dbg($value:expr) } => {
    ((inspected) => {
        globalThis.console.log(`${#text($value)} = ${globalThis.JSON.stringify(inspected)}`);
        return inspected;
      })($value)
  }
}

export syntax check:stmt {
  rule { check($left:expr === $right:expr); } => {
    {
      const actual = $left;
      const expected = $right;
      if (!globalThis.Object.is(actual, expected)) {
        throw new globalThis.Error(
          `${#text($left)} === ${#text($right)}` +
          `\n  left  = ${globalThis.JSON.stringify(actual)}` +
          `\n  right = ${globalThis.JSON.stringify(expected)}`,
        );
      }
    }
  }
}
