import {
  extend,
  (::),
  optional,
  record,
} from "./macros.sts" for syntax;

record Empty();
record Cons(head: number, tail: Empty | Cons);

extend Cons {
  last(self: Cons): number {
    return self.tail instanceof Empty ? self.head : last(self.tail);
  }
}

const list: optional<Cons> = new Cons(
  1,
  new Cons(3, new Empty()),
);
export const result = last() :: list;
