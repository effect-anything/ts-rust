{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true
  },
  "files": ["src/main.ts", "src/view.tsx", "src/logic.sts", "src/panel.stsx", "src/overload.d.ts", "src/jsx-runtime.d.ts"],
  "contentMappers": [
    { "package": "ext-syntax", "extensions": [".sts", ".stsx"] }
  ]
}
