{
  "name": "@effect-x/tsc",
  "version": "0.0.0",
  "private": true,
  "description": "Development package of crates/ts_ext_syntax: the tsc-ext content mapper and the Node API. The published @effect-x/tsc is built by npm/pack.mjs.",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "tsc-ext": "./bin/tsc-ext"
  },
  "typescript": {
    "contentMapper": {
      "exec": ["./bin/tsc-ext"]
    }
  },
  "napi": {
    "binaryName": "tsc-ext",
    "packageName": "@effect-x/tsc"
  },
  "scripts": {
    "build": "napi build --platform --output-dir ."
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.1"
  }
}
