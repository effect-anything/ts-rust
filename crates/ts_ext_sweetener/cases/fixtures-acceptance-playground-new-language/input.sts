import {
  extend,
  module,
  (::),
  optional,
  record,
} from "./declarative.sts" for syntax;

module List {
  record Empty();
  record Cons(head: number, tail: Empty | Cons);
}

extend List.Cons {
  last(self: List.Cons): number {
    return self.tail instanceof List.Empty ? self.head : last(self.tail);
  }
}

const list: optional<List.Cons> = new List.Cons(
  1,
  new List.Cons(3, new List.Empty()),
);
export const result = last() :: list;
