import { doSteps } from "./declarative.sts" for syntax;

type Box<A> = { readonly value: A };
const box = {
  of: <A>(value: A): Box<A> => ({ value }),
  flatMap: <A, B>(source: Box<A>, next: (value: A) => Box<B>): Box<B> =>
    next(source.value),
};

export const result = doSteps(box) {
  left <- box.of(2);
  right <- box.of(3);
  return left + right;
};
