syntax class CurryParameters {
  fields {
    first: binding;
    firstType: type;
    second: binding;
    secondType: type;
  }
  rule {
    ($first:binding: $firstType:type, $second:binding: $secondType:type,)
  }
  rule {
    ($first:binding: $firstType:type, $second:binding: $secondType:type)
  }
}

export syntax function:item shadows core {
  rule {
    export function $name:binding $parameters:CurryParameters:
      $resultType:type { $($body:stmt)* }
  }
  bind $name in following as recursive value;
  bind $parameters.first in $body as lexical value;
  bind $parameters.second in $body as lexical value;
  expect "two typed parameters";
  => {
    #core(export function $name(
      $parameters.first: $parameters.firstType
    ): ($parameters.second: $parameters.secondType) => $resultType;)
    #core(export function $name(
      $parameters.first: $parameters.firstType,
      $parameters.second: $parameters.secondType
    ): $resultType;)
    #core(export function $name(
      $parameters.first: $parameters.firstType,
      $parameters.second?: $parameters.secondType,
    ): $resultType | (($parameters.second: $parameters.secondType) => $resultType) {
      if ($parameters.second === undefined) {
        return ($parameters.second: $parameters.secondType): $resultType => { $($body)* };
      }
      $($body)*
    })
  }
}
