import {
  twice as cloneArmy,
  surround,
  dramatic,
  emergencyConfetti,
  orElse,
  collect,
  unless,
  repeat,
  readonlyList,
  summon,
  (|>)
} from "./macros.sts" for syntax;

export interface MacroCard {
  readonly name: string;
  readonly kind: "useful" | "silly";
  readonly result: string;
}

summon summonedMeaning

const shout = (value: string): string => value.toUpperCase();
const optionalSubtitle: string | undefined = undefined;
const copiedNumbers: readonlyList<number> = cloneArmy(summonedMeaning);
const missingCardResult: string | undefined = undefined;
const fallbackResult = orElse(missingCardResult, "backup arrived");
const pipelineResult = "quiet words" |> shout;
const surroundedResult = surround("tiny hat", "🎩 ", " 🐸");
const dramaticResult = dramatic("behold");
const confettiResult = emergencyConfetti("ship it");
const titleResult = "Sweetener macro carnival" |> shout;
const subtitleResult = orElse(optionalSubtitle, "One source module, many frameworks");
const heroResult = emergencyConfetti(dramaticResult);

function runAudit(): string[] {
  const audit: string[] = [];
  repeat(3) {
    audit.push(`macro pass ${audit.length + 1}`);
  }
  unless(copiedNumbers.length === 2) {
    throw new Error("the clone army lost a clone");
  }
  return audit;
}

export const showcase = {
  title: titleResult,
  subtitle: subtitleResult,
  hero: heroResult,
  copiedNumbers,
  audit: runAudit(),
  cards: collect(
    { name: "pipeline", kind: "useful", result: pipelineResult },
    { name: "fallback", kind: "useful", result: fallbackResult },
    { name: "surround", kind: "silly", result: surroundedResult },
    { name: "dramatic", kind: "silly", result: dramaticResult },
    { name: "confetti", kind: "silly", result: confettiResult }
  ) satisfies readonly MacroCard[]
} as const;
