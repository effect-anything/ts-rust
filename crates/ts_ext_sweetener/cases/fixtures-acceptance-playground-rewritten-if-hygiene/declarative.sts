import { IF } from "./runtime.js";

export syntax if:stmt shadows core {
  rule {
    if ($predicate:expr) {
      return $trueValue:expr;
    } else {
      return $falseValue:expr;
    }
  }
  expect "return statement in else block"
  => {
    return IF(
      $predicate,
      () => $trueValue,
      () => $falseValue,
    )();
  }
}
