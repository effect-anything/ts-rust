{
  "file_types": {
    "TypeScript": ["sts"],
    "TSX": ["stsx"]
  },
  "languages": {
    "TypeScript": {
      "language_servers": ["typescript-ls"]
    },
    "TSX": {
      "language_servers": ["typescript-ls"]
    }
  },
  "lsp": {
    "typescript-ls": {
      "binary": {
        "path": "./ext/typescript/bin/tsc",
        "arguments": ["--lsp", "--stdio"]
      }
    }
  }
}
